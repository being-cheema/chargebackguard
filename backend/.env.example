# ChargebackGuard Environment Configuration

# Server Port (dev: 5050 to match Vite proxy)
PORT=5050
NODE_ENV=development

# Database Connection (Optional: if omitted, embedded PGlite PostgreSQL will be used automatically)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chargebackguard

# Reviewer JWT Authentication Secret
JWT_SECRET=chargebackguard_production_secret_key_2026_super_secure_razorpay

# Decision Gate Threshold (Default 0.75)
DECISION_GATE_THRESHOLD=0.75

# Anthropic Claude API Key (Optional: if omitted, verified deterministic fallback drafter is used)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Razorpay Test Mode API Keys (Optional: required for live dispute sync + contest API)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_from_dashboard
# RAZORPAY_CONTEST_MODE=draft

# CORS (comma-separated origins in production; default * for dev)
# CORS_ORIGIN=http://localhost:5180
